# --- Bot ---------------------------------------------------------------
BOT_NAME=Mawar
# CS name used in the replies ("sembari menunggu CS Anggun online")
CS_NAME=Anggun

# Bot is active Mon-Sat from ACTIVE_FROM to ACTIVE_UNTIL (overnight), and all day Sunday.
TIMEZONE=Asia/Jakarta
ACTIVE_FROM=17:30
ACTIVE_UNTIL=07:30
# "always" = ignore the schedule (for testing), "never" = mute the bot. Leave empty normally.
BOT_FORCE=

# Wait this long after the customer's last bubble before replying (ms).
DEBOUNCE_MS=6000
# "typing..." pause before each bubble (ms).
TYPING_MS=1500
# How long the bot stays silent on a number after handing it to CS.
HANDOVER_HOURS=24
# A half-finished conversation idle this long starts over from the greeting.
RESET_HOURS=24

# Step [9] jersey promo. The spec has no text yet; empty = step skipped.
# Use \n for a line break.
JERSEY_PROMO_TEXT=

# --- Morning recap for CS ----------------------------------------------
# WhatsApp number(s) that get the list of overnight customers, comma separated,
# e.g. 6281234567890. Can be the bot's own number (lands in "Message yourself").
# Empty = no recap (the list is still visible in the console).
REKAP_KE=
# Defaults to ACTIVE_UNTIL. Not sent on Sundays; Monday's recap covers the weekend.
REKAP_JAM=

# --- Backup & retention ----------------------------------------------------
# Daily copy of the database. Point it at a folder that leaves this PC
# (Google Drive / OneDrive sync folder, NAS, USB). Empty = data/backups.
BACKUP_DIR=
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14
# Chat text older than this is deleted.
LOG_KEEP_DAYS=90

# --- AI (intent recognition only; replies are always the fixed spec text) ---
# Empty = keyword matching only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000

# --- Local HTTP (QR page, sessions, stats) -----------------------------
# Keep 127.0.0.1 so only this PC can open the QR page. To allow the LAN, set
# HOST=0.0.0.0 and API_KEY (then open http://<pc-ip>:3001/?key=<API_KEY>).
HOST=127.0.0.1
PORT=3001
API_KEY=
LOG_LEVEL=info

# Empty = data/chatbot.sqlite and media/ inside this folder.
DB_PATH=
MEDIA_DIR=

PRINT_QR=true
ALLOW_GROUPS=false
